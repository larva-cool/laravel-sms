{
  "name": "larva/laravel-sms",
  "description": "This is a SMS.",
  "keywords": [
    "laravel",
    "sms",
    "larva"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "illuminate/support": "^11.0|^12.0|^13.0",
    "illuminate/notifications": "^11.0|^12.0|^13.0",
    "overtrue/easy-sms": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "Larva\\Sms\\": "src"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "extra": {
    "branch-alias": {
      "dev-master": "2.0-dev"
    },
    "laravel": {
      "providers": [
        "Larva\\Sms\\SmsServiceProvider"
      ]
    }
  },
  "prefer-stable": true
}
